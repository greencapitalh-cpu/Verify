<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Evidence Detail | UDoChain Verify</title>
    <link rel="stylesheet" href="record-detail.css" />
  </head>
  <body>
    <header class="header">
      <div class="header-left">
        <img src="logo-udochain.png" class="logo" alt="UDoChain Logo" />
        <h1>Evidence Detail</h1>
      </div>
      <a href="records.html" class="nav-link">Back to Records</a>
    </header>

    <main class="container">
      <div id="recordContainer" class="record-box">Loading evidence...</div>

      <div class="actions">
        <button id="btnPublic" class="btn-primary">Make Public</button>
        <button id="btnPrivate" class="btn-secondary">Make Private</button>
        <button id="btnBlock" class="btn-danger">Deactivate</button>
        <button id="btnRegenerate" class="btn-accent">Generate New PDF</button>
      </div>
    </main>

    <footer class="footer">
      <p>UDoChain Verify — Evidence Management</p>
    </footer>

    <script type="module" src="record-detail.js"></script>
    <script src="script-translate.js"></script>
  </body>
</html>
