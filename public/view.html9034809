<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>UDoChain Verification</title>
<link rel="icon" href="logo-udochain.png" />
<link rel="stylesheet" href="styles.css" />

<style>
body { font-family:Inter,sans-serif; background:#f9fafb; margin:0; }
header { background:white; padding:1rem 1.5rem; border-bottom:1px solid #e2e8f0; display:flex; align-items:center; gap:10px; }
.logo { height:36px; }
.header-title { font-weight:700; color:#184b8c; }

main { display:flex; justify-content:center; padding:2rem 1rem; }
.card { background:white; border-radius:16px; padding:2rem; max-width:720px; width:100%; box-shadow:0 4px 14px rgba(0,0,0,0.06); }

h2 { text-align:center; color:#184b8c; margin-bottom:0.5rem; }
.subtitle { text-align:center; color:#64748b; margin-bottom:1.5rem; }

.field { margin-bottom:0.8rem; }
.label { font-weight:600; color:#475569; }
.value { display:block; word-break:break-all; }

.file-list div { margin-bottom:6px; }

.badge { display:block; margin:0 auto 1rem; padding:6px 12px; border-radius:12px; font-size:0.85rem; font-weight:600; width:fit-content; }
.verified { background:#dcfce7; color:#14532d; }
.unverified { background:#fee2e2; color:#991b1b; }

.divider { border-top:1px solid #e2e8f0; margin:1.5rem 0; }

.drop-zone {
border:2px dashed #cbd5e1;
border-radius:10px;
padding:40px;
text-align:center;
cursor:pointer;
color:#64748b;
transition:0.3s;
}
.drop-zone.dragover {
border-color:#184b8c;
background:#eff6ff;
}

#status { margin-top:1rem; font-weight:600; text-align:center; }
.ok { color:#14532d; }
.fail { color:#b91c1c; }

.download-btn {
width:100%;
padding:12px;
border-radius:10px;
border:none;
font-weight:600;
cursor:pointer;
margin-top:1rem;
background:#5b2e90;
color:white;
}
.info-box {
margin-top:1rem;
padding:12px;
border-radius:10px;
background:#ede9fe;
color:#5b2e90;
text-align:center;
font-size:0.9rem;
}
</style>
</head>

<body>

<header>
<img src="logo-udochain.png" class="logo" />
<span class="header-title">UDoChain Verify</span>
</header>

<main>
<div class="card">

<div id="badge"></div>

<h2>Validation Details</h2>
<p class="subtitle">Blockchain validation record</p>

<div id="details">Loading validation data...</div>

<div class="divider"></div>

<h2>File Verification</h2>
<p class="subtitle">Upload original file to verify integrity</p>

<div id="dropZone" class="drop-zone">
Drop or click to upload file
</div>

<div id="status"></div>
<div id="downloads"></div>

</div>
</main>

<script>
const detailsDiv = document.getElementById("details");
const badgeDiv = document.getElementById("badge");
const dropZone = document.getElementById("dropZone");
const statusDiv = document.getElementById("status");
const downloadsDiv = document.getElementById("downloads");

// 🔥 ACEPTA id o storage
const params = new URLSearchParams(window.location.search);
const rawParam = params.get("storage") || params.get("id");

let validatedFiles = [];

async function loadValidation() {

if (!rawParam) {
detailsDiv.innerHTML = "<p class='fail'>No storage ID provided.</p>";
return;
}

try {

// Decodifica correctamente
const decoded = decodeURIComponent(rawParam);
const cleanId = decoded.replace(/^ar:\/\//, "");

// 🔥 MISMO ENDPOINT QUE VERIFY-PRIVATE (HARDCODEADO)
const res = await fetch(
`https://api.udochain.com/validate/api/validate/storage/${encodeURIComponent(cleanId)}`
);

if (!res.ok) {
detailsDiv.innerHTML = "<p class='fail'>Server error.</p>";
return;
}

const data = await res.json();

if (!data?.ok) {
badgeDiv.innerHTML = `<div class="badge unverified">Unverified</div>`;
detailsDiv.innerHTML = "<p class='fail'>Validation not found.</p>";
return;
}

badgeDiv.innerHTML = `<div class="badge verified">Verified on Blockchain</div>`;

const date = new Date(data.validatedAt).toLocaleString();

detailsDiv.innerHTML = `
<div class="field"><span class="label">Evidence Title:</span><span class="value">${data.evidenceTitle || "—"}</span></div>
<div class="field"><span class="label">Transaction Hash:</span><span class="value">${data.txHash}</span></div>
<div class="field"><span class="label">Storage ID:</span><span class="value">${data.storageId}</span></div>
<div class="field"><span class="label">Validated By:</span><span class="value">${data.userEmail || "—"}</span></div>
<div class="field"><span class="label">GPS:</span><span class="value">${data.gps || "—"}</span></div>
<div class="field"><span class="label">Date:</span><span class="value">${date}</span></div>

<div class="field">
<span class="label">Files:</span>
<div class="value file-list">
${
(data.files || [])
.map(f => `<div>${f.name} — <small>${f.hash}</small></div>`)
.join("") || "No files recorded"
}
</div>
</div>
`;

validatedFiles = (data.files || []).map(f => f.hash.toLowerCase());

// 🔥 Botón de descarga solo si existe binario
if (data.binaryStorageId) {

const binId = data.binaryStorageId.replace("ar://", "");

downloadsDiv.innerHTML = `
<div class="info-box">
This validation includes custody backup stored in Aereware.
</div>
<button class="download-btn"
onclick="window.open('https://api.udochain.com/validate/api/validate/aereware/download/files/${binId}','_blank')">
Download Custody Files (ZIP)
</button>
`;
}

} catch (err) {
badgeDiv.innerHTML = `<div class="badge unverified">Unverified</div>`;
detailsDiv.innerHTML = "<p class='fail'>Error loading validation.</p>";
}
}

dropZone.addEventListener("click", () => {
const input = document.createElement("input");
input.type = "file";
input.accept = "*/*";
input.onchange = e => verifyFile(e.target.files[0]);
input.click();
});

async function verifyFile(file) {

if (!validatedFiles.length) {
statusDiv.innerHTML = "<p class='fail'>Validation data not loaded.</p>";
return;
}

statusDiv.textContent = "Analyzing file...";

const buffer = await file.arrayBuffer();
const hashBuffer = await crypto.subtle.digest("SHA-256", buffer);
const hashArray = Array.from(new Uint8Array(hashBuffer));
const fileHash = hashArray.map(b => b.toString(16).padStart(2,"0")).join("").toLowerCase();

if (validatedFiles.includes(fileHash)) {
statusDiv.innerHTML = `<p class="ok">This file matches the blockchain record.</p>`;
} else {
statusDiv.innerHTML = `<p class="fail">This file does NOT match the registered hash.</p>`;
}
}

loadValidation();
</script>

</body>
</html>
