@import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap");

body {
  font-family: "Inter", sans-serif;
  background: #f3f4f6;
  margin: 0;
  color: #1e293b;
}

/* HEADER */
.header {
  background: #ffffff;
  border-bottom: 1px solid #e5e7eb;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.8rem 1.5rem;
  position: sticky;
  top: 0;
  z-index: 10;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 10px;
}

.logo {
  height: 36px;
}

h1 {
  font-size: 1.5rem;
  font-weight: 600;
  color: #184b8c;
}

.nav-link {
  color: #184b8c;
  text-decoration: none;
  font-weight: 500;
}
.nav-link:hover {
  text-decoration: underline;
}

/* MAIN CONTAINER */
.container {
  max-width: 1000px;
  margin: 2rem auto;
  background: white;
  padding: 1.5rem;
  border-radius: 16px;
  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.05);
}

/* TOOLBAR + FILTERS */
.toolbar {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  margin-bottom: 1.2rem;
}

.toolbar input[type="text"] {
  width: 100%;
  padding: 0.75rem;
  border-radius: 10px;
  border: 1px solid #cbd5e1;
  font-size: 0.95rem;
}

.filters {
  display: flex;
  gap: 0.8rem;
  flex-wrap: wrap;
}

select,
input[type="date"] {
  padding: 0.6rem 1rem;
  border-radius: 8px;
  border: 1px solid #cbd5e1;
  background: #f9fafb;
  font-size: 0.9rem;
}

/* RECORD LIST */
.records-list {
  display: flex;
  flex-direction: column;
  gap: 0.8rem;
}

.record-item {
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 12px;
  padding: 1.2rem 1.4rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
  transition: all 0.25s ease;
  cursor: pointer;
}

.record-item:hover {
  background: #f0f7ff;
  transform: translateY(-2px);
  box-shadow: 0 3px 10px rgba(0, 0, 0, 0.05);
}

.record-info {
  display: flex;
  flex-direction: column;
}

.record-title {
  font-weight: 600;
  color: #1e3a8a;
  margin-bottom: 4px;
}

.record-meta {
  font-size: 0.85rem;
  color: #64748b;
  display: flex;
  gap: 8px;
  align-items: center;
}

.record-type {
  background: #e0e7ff;
  color: #1e40af;
  padding: 2px 8px;
  border-radius: 8px;
  font-size: 0.8rem;
}

.status {
  font-weight: 500;
}

.status.active {
  color: #16a34a;
}
.status.blocked {
  color: #dc2626;
}
.status.updated {
  color: #f59e0b;
}

.loading {
  color: #64748b;
  text-align: center;
  padding: 1rem;
}

/* FOOTER */
.footer {
  margin-top: 2rem;
  text-align: center;
  color: #6b7280;
  font-size: 0.85rem;
}

/* RESPONSIVE */
@media (max-width: 700px) {
  .record-item {
    flex-direction: column;
    align-items: flex-start;
  }
  .record-meta {
    flex-wrap: wrap;
  }
  .filters {
    flex-direction: column;
  }
}
