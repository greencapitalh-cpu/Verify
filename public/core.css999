@import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap");

/* ======================================================
   🎨 BASE — Tipografía, fondo y estructura
====================================================== */
body {
  font-family: "Inter", sans-serif;
  background: #f9fafb;
  color: #1e293b;
  margin: 0;
  padding: 0;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

h1, h2, h3 {
  margin: 0;
  font-weight: 600;
}

a {
  color: #184b8c;
  text-decoration: none;
}

a:hover {
  text-decoration: underline;
}

/* ======================================================
   🧭 HEADER / NAVIGATION
====================================================== */
.header {
  background: #ffffff;
  padding: 1rem 1.5rem;
  border-bottom: 1px solid #e2e8f0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: sticky;
  top: 0;
  z-index: 10;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 10px;
}

.logo {
  height: 36px;
}

/* ======================================================
   ⚙️ FOOTER
====================================================== */
.footer {
  margin-top: auto;
  text-align: center;
  color: #6b7280;
  font-size: 0.85rem;
  padding: 1rem;
  border-top: 1px solid #e5e7eb;
  background: #ffffff;
}
